{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "avi",
  "version": "0.1.0",
  "identifier": "me.csy20.avi",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "sh -c 'if [ -f ../package.json ]; then npm --prefix .. run dev:app; else npm run dev:app; fi'",
    "beforeBuildCommand": "sh -c 'if [ -f ../package.json ]; then npm --prefix .. run build:app; else npm run build:app; fi'"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "avi",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$VIDEO/**",
          "$AUDIO/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$DESKTOP/**",
          "$PICTURE/**",
          "$TEMP/**",
          "$APPCACHE/**",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
